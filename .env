# =============================================================================
# StoreCraft AI — Environment Configuration
# =============================================================================
# Production: Uses PostgreSQL + Redis (via docker-compose or managed services)
# Dev Local:  Override with .env.local for SQLite if needed
# =============================================================================

# PostgreSQL 16 — Primary Database
# For Docker: postgresql://storecraft:storecraft_prod_password@postgres:5432/storecraft?connection_limit=10&pool_timeout=30
DATABASE_URL=postgresql://storecraft:password@localhost:5432/storecraft?connection_limit=10&pool_timeout=30

# Redis 7 — Cache, Pub/Sub, BullMQ, Rate Limiting, Sessions
REDIS_URL=redis://localhost:6379

# NextAuth.js
NEXTAUTH_SECRET=storecraft-dev-secret-change-in-production-2024
NEXTAUTH_URL=http://localhost:3000

# Optional: Google OAuth (set in production)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional: Email provider (set in production)
# EMAIL_SERVER=smtp://user:pass@smtp.example.com:587
# EMAIL_FROM=noreply@storecraft.ai
