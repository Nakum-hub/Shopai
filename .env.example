# =============================================================================
# StoreCraft AI — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL 16 — Primary Database (REQUIRED)
# -----------------------------------------------------------------------------
# Local dev:
DATABASE_URL=postgresql://storecraft:your_password_here@localhost:5432/storecraft?connection_limit=10&pool_timeout=30
# Docker Compose (services communicate via container names):
# DATABASE_URL=postgresql://storecraft:your_password_here@postgres:5432/storecraft?connection_limit=10&pool_timeout=30

# Database password used by docker-compose for the postgres container
DB_PASSWORD=change_me_to_a_strong_password

# -----------------------------------------------------------------------------
# Redis 7 — Cache, Pub/Sub, BullMQ, Rate Limiting (REQUIRED)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# NextAuth.js (REQUIRED)
# -----------------------------------------------------------------------------
# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET=generate-a-strong-random-secret-here
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# WebSocket Gateway JWT Secret (REQUIRED for production)
# -----------------------------------------------------------------------------
# Generate a strong secret: openssl rand -hex 32
WS_JWT_SECRET=generate-a-strong-random-hex-here

# -----------------------------------------------------------------------------
# Google OAuth (OPTIONAL — enables "Sign in with Google")
# -----------------------------------------------------------------------------
# Get credentials at: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# -----------------------------------------------------------------------------
# Email Magic Link Provider (OPTIONAL — enables passwordless login)
# -----------------------------------------------------------------------------
# SMTP connection string
# EMAIL_SERVER=smtp://user:pass@smtp.example.com:587
# EMAIL_FROM=noreply@storecraft.ai

# -----------------------------------------------------------------------------
# Application Settings (OPTIONAL — sensible defaults used if not set)
# -----------------------------------------------------------------------------
# APP_NAME=StoreCraft AI
# APP_VERSION=2.0.0
# PORT=3000

# -----------------------------------------------------------------------------
# Rate Limits — requests per minute (OPTIONAL)
# -----------------------------------------------------------------------------
# RATE_LIMIT_CHAT=30
# RATE_LIMIT_GENERATE=5
# RATE_LIMIT_VOICE=10
# RATE_LIMIT_API=100

# -----------------------------------------------------------------------------
# CORS Origins — comma-separated (OPTIONAL, defaults to localhost:3000)
# -----------------------------------------------------------------------------
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# -----------------------------------------------------------------------------
# Worker Service (OPTIONAL)
# -----------------------------------------------------------------------------
# WORKER_CONCURRENCY=3

# -----------------------------------------------------------------------------
# AI Provider API Key (REQUIRED for AI-powered site generation)
# -----------------------------------------------------------------------------
# Uncomment and set ONE of the following based on your AI provider:
# OPENAI_API_KEY=sk-your-openai-api-key-here
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
# GOOGLE_AI_API_KEY=your-google-ai-key-here
#
# Get keys at:
#   OpenAI:    https://platform.openai.com/api-keys
#   Anthropic: https://console.anthropic.com/settings/keys
#   Google AI: https://aistudio.google.com/apikey

# -----------------------------------------------------------------------------
# Feature Flags — comma-separated (OPTIONAL)
# -----------------------------------------------------------------------------
# FEATURE_FLAGS=voice_input,template_marketplace,analytics_dashboard
