generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// User (tenant isolation groundwork)
// =============================================================================

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  name      String?
  role      String   @default("user") // user, admin
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  storefronts           Storefront[]
  conversationSessions  ConversationSession[]
  semanticMemories      SemanticMemory[]

  @@index([email])
  @@index([role])
}

// =============================================================================
// Storefront (Generated Website)
// =============================================================================

model Storefront {
  id              String   @id @default(cuid())
  name            String
  businessName    String
  category        String   @default("other")
  status          String   @default("draft") // draft, generating, ready, published, error
  description     String?
  url             String?
  html            String   @db.Text
  businessProfile String?  @db.Text // JSON business profile
  deploymentStatus String  @default("none")
  deploymentUrl   String?
  publishedAt     DateTime?
  viewCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  userId          String?

  user               User?              @relation(fields: [userId], references: [id])
  analytics          StorefrontAnalytics[]
  generationJobs     GenerationJob[]
  pipelineExecutions PipelineExecution[]

  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([status, createdAt])
  @@index([category, status])
  @@index([businessName])
  @@index([userId])
}

// =============================================================================
// Storefront Analytics (daily aggregates)
// =============================================================================

model StorefrontAnalytics {
  id                String   @id @default(cuid())
  storefrontId      String
  totalViews        Int      @default(0)
  uniqueVisitors    Int      @default(0)
  avgDuration       Int      @default(0) // seconds
  bounceRate        Float    @default(0)
  seoScore          Int      @default(0)
  performanceScore  Int      @default(0)
  accessibilityScore Int     @default(0)
  date              String   // YYYY-MM-DD
  createdAt         DateTime @default(now())

  storefront Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)

  @@unique([storefrontId, date])
  @@index([storefrontId])
  @@index([date])
}

// =============================================================================
// Generation Job (legacy, kept for backward compatibility)
// =============================================================================

model GenerationJob {
  id              String    @id @default(cuid())
  storefrontId    String
  status          String    @default("idle")
  progress        Int       @default(0)
  message         String?   @db.Text
  voiceTranscript String?   @db.Text
  logs            String?   @db.Text // JSON array of logs
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  storefront Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)

  @@index([storefrontId])
  @@index([status])
}

// =============================================================================
// Pipeline Execution (real orchestration tracking)
// =============================================================================

model PipelineExecution {
  id              String    @id @default(cuid())
  storefrontId    String?
  sessionId       String
  status          String    @default("pending") // pending, running, completed, failed, cancelled
  currentStage    String
  totalStages     Int       @default(9)
  progress        Int       @default(0)
  inputSnapshot   String?   @db.Text // JSON: the business profile / prompt that triggered this run
  outputHtml      String?   @db.Text // final generated HTML
  validationScore Int?
  errorMessage    String?   @db.Text
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  durationMs      Int?      // completion time in milliseconds

  logs       PipelineLog[]
  storefront Storefront?    @relation(fields: [storefrontId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([storefrontId])
  @@index([status])
  @@index([startedAt])
  @@index([status, startedAt])
  @@index([storefrontId, status])
}

// =============================================================================
// Pipeline Log (stage-by-stage execution log)
// =============================================================================

model PipelineLog {
  id          String   @id @default(cuid())
  executionId String
  stage       String   // processing_voice, understanding_business, etc.
  level       String   @default("info") // info, success, warning, error
  agent       String
  message     String
  detail      String?  @db.Text
  inputTokens Int?
  outputTokens Int?
  durationMs  Int?
  timestamp   DateTime @default(now())

  execution PipelineExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@index([executionId, stage])
  @@index([stage])
  @@index([timestamp])
}

// =============================================================================
// Conversation Session (persistent chat memory)
// =============================================================================

model ConversationSession {
  id              String    @id @default(cuid())
  sessionId       String    @unique
  storefrontId    String?
  businessProfile String?   @db.Text // JSON: extracted business profile
  messageCount    Int       @default(0)
  lastMessageAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  userId          String?

  user     User?         @relation(fields: [userId], references: [id])
  messages ChatHistory[]

  @@index([sessionId])
  @@index([storefrontId])
  @@index([lastMessageAt])
  @@index([userId])
}

// =============================================================================
// Chat History (persistent messages)
// =============================================================================

model ChatHistory {
  id        String   @id @default(cuid())
  sessionId String
  session   ConversationSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  role      String   // user, assistant, system
  content   String   @db.Text
  metadata  String?  @db.Text // JSON metadata
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([createdAt])
  @@index([role])
}

// =============================================================================
// Template
// =============================================================================

model Template {
  id            String   @id @default(cuid())
  name          String
  description   String?  @db.Text
  category      String   @default("other")
  preview       String?  // CSS gradient string
  sections      String?  @db.Text // JSON sections config
  style         String?  @db.Text // JSON brand style
  popular       Boolean  @default(false)
  featured      Boolean  @default(false)
  downloadCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([popular])
  @@index([downloadCount])
}

// =============================================================================
// Semantic Memory (persistent business/user memory)
// =============================================================================

model SemanticMemory {
  id         String    @id @default(cuid())
  sessionId  String
  category   String    // 'business_profile' | 'user_preference' | 'generation_insight' | 'conversation_fact'
  key        String    // e.g., "business_name", "preferred_color", "generation_tip"
  value      String    @db.Text // the actual stored value
  confidence Float     @default(1.0) // 0.0 to 1.0
  source     String    // 'voice' | 'chat' | 'generation' | 'system'
  expiresAt  DateTime? // optional TTL
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  userId     String?

  user User? @relation(fields: [userId], references: [id])

  @@unique([sessionId, key])
  @@index([sessionId])
  @@index([category])
  @@index([key])
  @@index([userId])
}
