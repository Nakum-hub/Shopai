generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =============================================================================
// User (NextAuth + tenant isolation)
// =============================================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("user") // user, admin
  password      String?   // hashed password for Credentials provider
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // NextAuth relations
  accounts      Account[]
  sessions      Session[]

  // Tenant isolation relations
  storefronts           Storefront[]
  conversationSessions  ConversationSession[]
  semanticMemories      SemanticMemory[]

  @@index([email])
  @@index([role])
}

// =============================================================================
// Account (NextAuth OAuth accounts)
// =============================================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// =============================================================================
// Session (NextAuth session tokens)
// =============================================================================

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// =============================================================================
// VerificationToken (NextAuth email verification / magic links)
// =============================================================================

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =============================================================================
// Storefront (Generated Website)
// =============================================================================

model Storefront {
  id              String   @id @default(cuid())
  name            String
  businessName    String
  category        String   @default("other")
  status          String   @default("draft") // draft, generating, ready, published, error
  description     String?
  url             String?
  html            String  
  businessProfile String?  // JSON business profile
  deploymentStatus String  @default("none")
  deploymentUrl   String?
  publishedAt     DateTime?
  viewCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  userId          String?

  user               User?              @relation(fields: [userId], references: [id])
  analytics          StorefrontAnalytics[]
  generationJobs     GenerationJob[]
  pipelineExecutions PipelineExecution[]

  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([status, createdAt])
  @@index([category, status])
  @@index([businessName])
  @@index([userId])
}

// =============================================================================
// Storefront Analytics (daily aggregates)
// =============================================================================

model StorefrontAnalytics {
  id                String   @id @default(cuid())
  storefrontId      String
  totalViews        Int      @default(0)
  uniqueVisitors    Int      @default(0)
  avgDuration       Int      @default(0) // seconds
  bounceRate        Float    @default(0)
  seoScore          Int      @default(0)
  performanceScore  Int      @default(0)
  accessibilityScore Int     @default(0)
  date              String   // YYYY-MM-DD
  createdAt         DateTime @default(now())

  storefront Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)

  @@unique([storefrontId, date])
  @@index([storefrontId])
  @@index([date])
}

// =============================================================================
// Generation Job (legacy, kept for backward compatibility)
// =============================================================================

model GenerationJob {
  id              String    @id @default(cuid())
  storefrontId    String
  status          String    @default("idle")
  progress        Int       @default(0)
  message         String?  
  voiceTranscript String?  
  logs            String?   // JSON array of logs
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  storefront Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)

  @@index([storefrontId])
  @@index([status])
}

// =============================================================================
// Pipeline Execution (real orchestration tracking)
// =============================================================================

model PipelineExecution {
  id              String    @id @default(cuid())
  storefrontId    String?
  sessionId       String
  status          String    @default("pending") // pending, running, completed, failed, cancelled
  currentStage    String
  totalStages     Int       @default(9)
  progress        Int       @default(0)
  inputSnapshot   String?   // JSON: the business profile / prompt that triggered this run
  outputHtml      String?   // final generated HTML
  validationScore Int?
  errorMessage    String?  
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  durationMs      Int?      // completion time in milliseconds

  logs       PipelineLog[]
  storefront Storefront?    @relation(fields: [storefrontId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([storefrontId])
  @@index([status])
  @@index([startedAt])
  @@index([status, startedAt])
  @@index([storefrontId, status])
}

// =============================================================================
// Pipeline Log (stage-by-stage execution log)
// =============================================================================

model PipelineLog {
  id          String   @id @default(cuid())
  executionId String
  stage       String   // processing_voice, understanding_business, etc.
  level       String   @default("info") // info, success, warning, error
  agent       String
  message     String
  detail      String? 
  inputTokens Int?
  outputTokens Int?
  durationMs  Int?
  timestamp   DateTime @default(now())

  execution PipelineExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@index([executionId, stage])
  @@index([stage])
  @@index([timestamp])
}

// =============================================================================
// Conversation Session (persistent chat memory)
// =============================================================================

model ConversationSession {
  id              String    @id @default(cuid())
  sessionId       String    @unique
  storefrontId    String?
  businessProfile String?   // JSON: extracted business profile
  messageCount    Int       @default(0)
  lastMessageAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  userId          String?

  user     User?         @relation(fields: [userId], references: [id])
  messages ChatHistory[]

  @@index([sessionId])
  @@index([storefrontId])
  @@index([lastMessageAt])
  @@index([userId])
}

// =============================================================================
// Chat History (persistent messages)
// =============================================================================

model ChatHistory {
  id        String   @id @default(cuid())
  sessionId String
  session   ConversationSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  role      String   // user, assistant, system
  content   String  
  metadata  String?  // JSON metadata
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([createdAt])
  @@index([role])
}

// =============================================================================
// Template
// =============================================================================

model Template {
  id            String   @id @default(cuid())
  name          String
  description   String? 
  category      String   @default("other")
  preview       String?  // CSS gradient string
  sections      String?  // JSON sections config
  style         String?  // JSON brand style
  popular       Boolean  @default(false)
  featured      Boolean  @default(false)
  downloadCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([popular])
  @@index([downloadCount])
}

// =============================================================================
// Semantic Memory (persistent business/user memory)
// =============================================================================

model SemanticMemory {
  id         String    @id @default(cuid())
  sessionId  String
  category   String    // 'business_profile' | 'user_preference' | 'generation_insight' | 'conversation_fact'
  key        String    // e.g., "business_name", "preferred_color", "generation_tip"
  value      String    // the actual stored value
  confidence Float     @default(1.0) // 0.0 to 1.0
  source     String    // 'voice' | 'chat' | 'generation' | 'system'
  expiresAt  DateTime? // optional TTL
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  userId     String?

  user User? @relation(fields: [userId], references: [id])

  @@unique([sessionId, key])
  @@index([sessionId])
  @@index([category])
  @@index([key])
  @@index([userId])
}

// =============================================================================
// Audit Log (structured audit trail)
// =============================================================================

model AuditLog {
  id            String   @id @default(cuid())
  timestamp     DateTime @default(now())
  actorId       String?
  actorType     String   @default("anonymous") // user, system, admin, anonymous
  action        String   // e.g. "storefront.create", "auth.login"
  resource      String   // e.g. "storefront", "chat_session", "user"
  resourceId    String?
  level         String   @default("info") // info, warn, critical
  details       String?  // JSON string
  ip            String?
  userAgent     String?
  sessionId     String?
  correlationId String?

  @@index([actorId])
  @@index([action])
  @@index([resource, resourceId])
  @@index([timestamp])
  @@index([level])
}
