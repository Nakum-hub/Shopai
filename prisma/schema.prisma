generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Storefront {
  id              String   @id @default(cuid())
  name            String
  businessName    String
  category        String   @default("other")
  status          String   @default("draft") // draft, generating, ready, published, error
  description     String?
  url             String?
  html            String?  // generated HTML
  businessProfile String?  // JSON business profile
  deploymentStatus String  @default("none")
  deploymentUrl   String?
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  analytics       StorefrontAnalytics[]
  generationJobs  GenerationJob[]
}

model StorefrontAnalytics {
  id              String   @id @default(cuid())
  storefrontId    String
  totalViews      Int      @default(0)
  uniqueVisitors Int      @default(0)
  avgDuration     Int      @default(0) // seconds
  bounceRate      Float    @default(0)
  seoScore        Int      @default(0)
  performanceScore Int    @default(0)
  accessibilityScore Int  @default(0)
  date            String   // YYYY-MM-DD
  createdAt       DateTime @default(now())

  storefront      Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
}

model GenerationJob {
  id              String   @id @default(cuid())
  storefrontId    String
  status          String   @default("idle")
  progress        Int      @default(0)
  message         String?
  voiceTranscript String?
  logs            String?  // JSON array of logs
  startedAt       DateTime @default(now())
  completedAt     DateTime?

  storefront      Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
}

model Template {
  id              String   @id @default(cuid())
  name            String
  description     String?
  category        String   @default("other")
  preview         String?
  sections        String?  // JSON sections config
  style           String?  // JSON brand style
  popular         Boolean  @default(false)
  featured        Boolean  @default(false)
  downloadCount   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ChatHistory {
  id              String   @id @default(cuid())
  sessionId       String
  role            String   // user, assistant, system
  content         String
  metadata        String?  // JSON metadata
  createdAt       DateTime @default(now())
}
